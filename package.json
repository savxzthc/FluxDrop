{
  "name": "fluxdrop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "site:dev": "vite --config vite.website.config.ts --host 127.0.0.1 --port 4173 --strictPort",
